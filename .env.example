# =====================================================================
# SH!T PLATFORM — ENVIRONMENT CONFIGURATION
# Free Spark Plan: Firebase Auth (Google Sign-In) + Cloud Firestore
# =====================================================================

# Firebase Web Configuration (Get from Firebase Console > Project Settings > General > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Firebase Admin Service Account Key JSON (for server-side token verification)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# OpenRouter AI Configuration (Server-side only — never exposed to client)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
