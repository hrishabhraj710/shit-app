rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the authenticated user owns this resource path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // All user-scoped collections under /users/{userId}
    match /users/{userId} {
      // Profile document: read and write only by owner
      allow read, write: if isOwner(userId);

      // Resumes subcollection
      match /resumes/{resumeId} {
        allow read, write: if isOwner(userId);
      }

      // Projects subcollection
      match /projects/{projectId} {
        allow read, write: if isOwner(userId);

        // Practice sessions under project
        match /sessions/{sessionId} {
          allow read, write: if isOwner(userId);
        }

        // Questions generated under project
        match /questions/{questionId} {
          allow read, write: if isOwner(userId);
        }

        // Answer attempts under project
        match /attempts/{attemptId} {
          allow read, write: if isOwner(userId);
        }

        // Topic mastery records under project
        match /topicMastery/{topicId} {
          allow read, write: if isOwner(userId);
        }
      }

      // User streaks subcollection
      match /streaks/{streakId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other collections by default (zero-trust security model)
    match /{document=**} {
      allow read, write: false;
    }
  }
}
